+  // Per-monitor bar zoom, read from shell.json as bar.scaleByMonitor, e.g.
+  //   "scaleByMonitor": { "eDP-1": 1.4 }
+  // Style is a singleton, so its font tokens are one value for the whole
+  // desktop and cannot differ per screen. Each BarPanel is its own window with
+  // its own screen though, so the panel lays the bar out at its natural size
+  // and then scales the result -- which magnifies the text and icons rather
+  // than only adding padding around them.
+  function barScaleFor(screen) {
+    var name = screen && screen.name ? String(screen.name) : ""
+    var map = Util.isPlainObject(barConfig) ? barConfig.scaleByMonitor : null
+    if (map && name && map[name] !== undefined) {
+      var value = parseFloat(map[name])
+      if (isFinite(value) && value > 0) return value
+    }
+    return 1.0
+  }
